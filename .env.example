# Copy to .env and fill in. Never commit .env.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Leave empty to use the bundled mock provider.
UPSTREAM_URL=
UPSTREAM_API_KEY=

# closed = reject requests with 503 if Redis is down (default); open = allow without budget checks
BUDGET_FAIL_MODE=closed
ENABLE_RELEVANCE_EVAL=false
